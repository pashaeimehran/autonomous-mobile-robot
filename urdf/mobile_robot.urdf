<?xml version="1.0"?>
<robot name="autonomous_mobile_robot">
  <material name="sensor_gray">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <link name="base_link"/>

  <link name="laser">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.03"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.1007 0 0.0558" rpy="0 0 0"/>
  </joint>
</robot>
