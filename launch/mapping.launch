<launch>
  <arg name="start_motor_driver" default="true"/>
  <include file="$(find autonomous_mobile_robot)/launch/bringup.launch">
    <arg name="start_motor_driver" value="$(arg start_motor_driver)"/>
  </include>

  <node pkg="cartographer_ros" type="cartographer_node"
        name="cartographer_node" output="screen"
        args="-configuration_directory $(find autonomous_mobile_robot)/config
              -configuration_basename cartographer_2d.lua">
    <remap from="scan" to="/scan"/>
  </node>
  <node pkg="cartographer_ros" type="cartographer_occupancy_grid_node"
        name="cartographer_occupancy_grid_node" output="screen"
        args="-resolution 0.05"/>
</launch>
