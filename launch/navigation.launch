<launch>
  <arg name="start_motor_driver" default="true"/>
  <include file="$(find autonomous_mobile_robot)/launch/mapping.launch">
    <arg name="start_motor_driver" value="$(arg start_motor_driver)"/>
  </include>

  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="controller_frequency" value="10.0"/>
    <rosparam file="$(find autonomous_mobile_robot)/config/costmap_common_params.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find autonomous_mobile_robot)/config/costmap_common_params.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find autonomous_mobile_robot)/config/global_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find autonomous_mobile_robot)/config/local_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find autonomous_mobile_robot)/config/dwa_local_planner_params.yaml"
              command="load"/>
  </node>
</launch>
